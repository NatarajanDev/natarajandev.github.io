# Nova CMS — environment template
#
# Copy to config/config.local.php (or export these variables in your web server /
# container) and edit. Every value is optional: the defaults in config/config.php
# boot a working SQLite install with no configuration at all.

# ------------------------------------------------------------------- app
CMS_APP_NAME="Nova CMS"
CMS_ENV=production              # production | staging | development
CMS_DEBUG=false                 # true prints stack traces instead of the 500 page
CMS_URL=https://example.com     # used for canonical URLs, feeds and the sitemap
CMS_TIMEZONE=UTC
CMS_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- storage
# Absolute path to a writable directory (logs, cache, sessions).
CMS_STORAGE_PATH=/var/www/nova-cms/storage
# Absolute path to public/uploads.
CMS_UPLOAD_PATH=/var/www/nova-cms/public/uploads

# --------------------------------------------------------------- database
# SQLite (default) — the file is created automatically by the installer.
CMS_DB_DRIVER=sqlite
CMS_DB_PATH=/var/www/nova-cms/storage/cms.sqlite

# MySQL / MariaDB alternative — uncomment to switch drivers.
# CMS_DB_DRIVER=mysql
# CMS_DB_HOST=127.0.0.1
# CMS_DB_PORT=3306
# CMS_DB_NAME=nova_cms
# CMS_DB_USER=nova
# CMS_DB_PASS=secret

# --------------------------------------------------------------- security
CMS_SESSION_NAME=nova_cms_session
CMS_SESSION_LIFETIME=7200       # seconds
CMS_LOGIN_MAX_ATTEMPTS=5
CMS_LOGIN_LOCKOUT=15            # minutes

# ---------------------------------------------------------------- uploads
CMS_UPLOAD_MAX_BYTES=5242880    # 5 MB

# ------------------------------------------------- CLI installer defaults
# Optional: lets `php bin/install.php` run unattended.
CMS_ADMIN_NAME="Site Owner"
CMS_ADMIN_EMAIL=owner@example.com
CMS_ADMIN_PASSWORD=change-this-password
